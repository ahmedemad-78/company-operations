# ---------------------------------------------------------------------------
# قاعدة البيانات: Postgres على Supabase، ومقسومة مساحتين منفصلتين:
#
#   بيانات الشركة الحقيقية (اللايف) => schema اسمه public  ← برانش main
#   بيانات التطوير والتجربة         => schema اسمه dev     ← برانش dev
#
# الفرق بين الرابطين هو المقطع schema=dev في آخر الرابط فقط.
# التشغيل يستخدم الـtransaction pooler (بورت 6543)، وتعديل الجداول يستخدم
# الـsession pooler (بورت 5432) عبر DIRECT_URL.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&schema=dev"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=dev"

# مفتاح تشفير الجلسات — لازم يتغير قبل النشر (32 حرفًا عشوائيًا على الأقل)
AUTH_SECRET="generate-a-long-random-secret"

# توقيت القاهرة — مهم جدًا لأن الإقفال اليومي والحضور يعتمدان على "اليوم"
# سيرفرات Vercel تعمل بتوقيت UTC، والاسم TZ محجوز عندها، فيُضبط عبر src/instrumentation.ts
APP_TIMEZONE="Africa/Cairo"

# بيانات أول تسجيل دخول (تُستخدم عند تشغيل npm run db:seed)
SEED_ADMIN_EMAIL="admin@company.local"
SEED_ADMIN_PASSWORD="change-me"
SEED_MANAGER1_EMAIL="manager1@company.local"
SEED_MANAGER2_EMAIL="manager2@company.local"
SEED_MANAGER_PASSWORD="change-me"
